<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GrannyCraft</AssemblyName>
    <RootNamespace>GrannyCraft</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <NoWarn>MSB3277;CS0436;CS8632</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- a Granny Legacy folder with BepInEx installed and run once: dotnet build -p:Game="path\to\Granny Legacy" -->
    <Game Condition="'$(Game)' == ''">$(MSBuildThisFileDirectory)..\game\Granny Legacy</Game>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(Game)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\Unity.AI.Navigation.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\Unity.Postprocessing.Runtime.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(Game)\BepInEx\interop\UnityEngine.UI.dll" Private="false" />
  </ItemGroup>
</Project>
